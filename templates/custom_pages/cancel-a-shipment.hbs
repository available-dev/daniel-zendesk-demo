<style>
  .fa-wrap {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background: #f4f4f2;
  }
  .fa-card {
    background: #fff;
    border-radius: 4px;
    padding: 2.5rem 2rem;
    width: 100%;
    max-width: 520px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.07);
    font-family: sans-serif;
  }
  .fa-card h1 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    color: #1a1a1a;
  }
  .fa-subtitle {
    font-size: 0.9rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }
  .fa-field { margin-bottom: 1.25rem; }
  .fa-field label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 0.4rem;
  }
  .fa-field input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #d4d4d0;
    border-radius: 3px;
    font-size: 0.9rem;
    color: #1a1a1a;
    background: #fafaf8;
    outline: none;
    box-sizing: border-box;
  }
  .fa-field input:focus {
    border-color: #3a7a5a;
    box-shadow: 0 0 0 3px rgba(58,122,90,0.12);
  }
  .fa-field input.fa-error { border-color: #c0392b; }
  .fa-error-msg {
    font-size: 0.78rem;
    color: #c0392b;
    margin-top: 0.3rem;
    display: none;
  }
  .fa-btn {
    width: 100%;
    padding: 0.9rem;
    background: #3a7a5a;
    color: #fff;
    border: none;
    border-radius: 3px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 0.5rem;
  }
  .fa-btn:hover { background: #2e6347; }
  .fa-btn:disabled { background: #8ab5a0; cursor: not-allowed; }
  .fa-footer-note {
    font-size: 0.8rem;
    color: #888;
    margin-top: 1rem;
    text-align: center;
  }
  .fa-success {
    display: none;
    text-align: center;
    padding: 2rem 0;
  }
  .fa-checkmark {
    width: 52px;
    height: 52px;
    background: #3a7a5a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }
  .fa-checkmark svg {
    width: 26px;
    height: 26px;
    stroke: #fff;
    stroke-width: 2.5;
    fill: none;
  }
  .fa-success h2 { font-size: 1.1rem; margin-bottom: 0.5rem; color: #1a1a1a; }
  .fa-success p { font-size: 0.9rem; color: #666; line-height: 1.6; }
  .fa-spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: fa-spin 0.7s linear infinite;
    vertical-align: middle;
    margin-right: 6px;
  }
  @keyframes fa-spin { to { transform: rotate(360deg); } }
</style>

<div class="fa-wrap">
  <div class="fa-card">
    <div id="fa-form-content">
      <h1 id="fa-title"></h1>
      <p class="fa-subtitle" id="fa-subtitle"></p>
      <form id="fa-form" novalidate>
        <div class="fa-field">
          <label for="fa-navn" id="fa-label-navn"></label>
          <input type="text" id="fa-navn" />
          <div class="fa-error-msg" id="fa-navn-error"></div>
        </div>
        <div class="fa-field">
          <label for="fa-ordre" id="fa-label-ordre"></label>
          <input type="text" id="fa-ordre" />
          <div class="fa-error-msg" id="fa-ordre-error"></div>
        </div>
        <div class="fa-field">
          <label for="fa-email" id="fa-label-email"></label>
          <input type="email" id="fa-email" />
          <div class="fa-error-msg" id="fa-email-error"></div>
        </div>
        <button type="submit" class="fa-btn" id="fa-btn"></button>
        <p class="fa-footer-note" id="fa-footer"></p>
      </form>
    </div>
    <div class="fa-success" id="fa-success">
      <div class="fa-checkmark">
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h2 id="fa-success-title"></h2>
      <p id="fa-success-text"></p>
    </div>
  </div>
</div>

<script>
(function() {
  var SUBDOMAIN = 'd3v-availableaps';
  var FORM_ID = 46591902474257;

  var t = {
    title: 'Cancel Agreement',
    subtitle: 'Please fill out the form below to cancel your purchase. We will send a confirmation to your email address.',
    navn: 'Name',
    navnPlaceholder: 'Enter your full name',
    navnError: 'Please enter your name.',
    ordre: 'Order details',
    ordrePlaceholder: 'Enter order number e.g., 12345',
    ordreError: 'Please enter your order details.',
    email: 'Email address',
    emailPlaceholder: 'Enter your email',
    emailError: 'Please enter a valid email address.',
    btn: 'Confirm Cancellation',
    footer: 'An automatic receipt will be sent immediately after submission.',
    successTitle: 'Request received',
    successText: 'We have received your cancellation and will get back to you as soon as possible. Please check your inbox for a confirmation.',
    sending: 'Sending...',
    error: 'An error occurred. Please try again.'
  };
  // Danish copy when the help center is viewed in Danish
  var LOCALE = (location.pathname.match(/^\/hc\/([a-z]{2}(?:-[a-z0-9]+)?)(?:\/|$)/i) || [null, 'en-us'])[1].toLowerCase();
  if (LOCALE.indexOf('da') === 0) {
    t = {
      title: 'Fortryd afsendelse',
      subtitle: 'Udfyld formularen herunder for at fortryde dit køb. Vi sender en bekræftelse til din e-mailadresse.',
      navn: 'Navn',
      navnPlaceholder: 'Indtast dit fulde navn',
      navnError: 'Indtast venligst dit navn.',
      ordre: 'Ordreoplysninger',
      ordrePlaceholder: 'Indtast ordrenummer, f.eks. 12345',
      ordreError: 'Indtast venligst dine ordreoplysninger.',
      email: 'E-mailadresse',
      emailPlaceholder: 'Indtast din e-mail',
      emailError: 'Indtast venligst en gyldig e-mailadresse.',
      btn: 'Bekræft fortrydelse',
      footer: 'En automatisk kvittering sendes straks efter indsendelse.',
      successTitle: 'Anmodning modtaget',
      successText: 'Vi har modtaget din fortrydelse og vender tilbage hurtigst muligt. Tjek din indbakke for en bekræftelse.'
    };
  }

  // Populate the form texts
  document.getElementById('fa-title').textContent = t.title;
  document.getElementById('fa-subtitle').textContent = t.subtitle;
  document.getElementById('fa-label-navn').textContent = t.navn;
  document.getElementById('fa-navn').placeholder = t.navnPlaceholder;
  document.getElementById('fa-navn-error').textContent = t.navnError;
  document.getElementById('fa-label-ordre').textContent = t.ordre;
  document.getElementById('fa-ordre').placeholder = t.ordrePlaceholder;
  document.getElementById('fa-ordre-error').textContent = t.ordreError;
  document.getElementById('fa-label-email').textContent = t.email;
  document.getElementById('fa-email').placeholder = t.emailPlaceholder;
  document.getElementById('fa-email-error').textContent = t.emailError;
  document.getElementById('fa-btn').textContent = t.btn;
  document.getElementById('fa-footer').textContent = t.footer;
  document.getElementById('fa-success-title').textContent = t.successTitle;
  document.getElementById('fa-success-text').textContent = t.successText;

  var form = document.getElementById('fa-form');
  var btn = document.getElementById('fa-btn');

  function validate() {
    var valid = true;
    var navn = document.getElementById('fa-navn');
    var ordre = document.getElementById('fa-ordre');
    var email = document.getElementById('fa-email');
    [navn, ordre, email].forEach(function(el) {
      el.classList.remove('fa-error');
      el.nextElementSibling.style.display = 'none';
    });
    if (!navn.value.trim()) {
      navn.classList.add('fa-error');
      document.getElementById('fa-navn-error').style.display = 'block';
      valid = false;
    }
    if (!ordre.value.trim()) {
      ordre.classList.add('fa-error');
      document.getElementById('fa-ordre-error').style.display = 'block';
      valid = false;
    }
    var emailVal = email.value.trim();
    if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
      email.classList.add('fa-error');
      document.getElementById('fa-email-error').style.display = 'block';
      valid = false;
    }
    return valid;
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (!validate()) return;
    var navn = document.getElementById('fa-navn').value.trim();
    var ordre = document.getElementById('fa-ordre').value.trim();
    var email = document.getElementById('fa-email').value.trim();
    btn.disabled = true;
    btn.innerHTML = '<span class="fa-spinner"></span>' + t.sending;

    fetch('/hc/' + LOCALE + '/requests/new', {
      credentials: 'include'
    })
    .then(function(r) { return r.text(); })
    .then(function(html) {
      var match = html.match(/name="authenticity_token" value="([^"]+)"/);
      if (!match) throw new Error('Token not found');
      var csrfToken = match[1];

      return fetch('https://' + SUBDOMAIN + '.zendesk.com/api/v2/requests.json', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({
          request: {
            requester: { name: navn, email: email },
            subject: 'Cancel agreement – Order: ' + ordre,
            ticket_form_id: FORM_ID,
            comment: { body: 'Cancellation of agreement\n\nName: ' + navn + '\nOrder details: ' + ordre + '\nEmail: ' + email }
          }
        })
      });
    })
    .then(function(res) {
      if (res.ok) {
        document.getElementById('fa-form-content').style.display = 'none';
        document.getElementById('fa-success').style.display = 'block';
      } else { throw new Error(); }
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = t.btn;
      alert(t.error);
    });
  });
})();
</script>