<h1 class="visibility-hidden">{{ help_center.name }}</h1>

<div class="tm-wrap">
  <section id="main-content" class="tm-home-hero">
    <h2 class="tm-welcome">Welcome to {{help_center.name}} <span aria-hidden="true">👋</span></h2>

    <div class="tm-banner">
      <div class="tm-banner-copy">
        <p class="tm-banner-kicker">Help Center</p>
        <h3 class="tm-banner-title">How can we<br>help you today?</h3>
        <p class="tm-banner-lead">Guides, answers and support for orders, delivery, returns and everything in between.</p>
        <div class="tm-banner-actions">
          <a href="#tm-categories" class="tm-btn tm-btn-light">Browse all topics</a>
          {{#link 'new_request' class='tm-btn tm-btn-ghost'}}Contact support{{/link}}
        </div>
      </div>
    </div>

    <ul class="tm-usps">
      <li><span class="tm-hex tm-hex-blue">30</span><span>Days money-back guarantee</span></li>
      <li><span class="tm-hex tm-hex-green">3</span><span>Years warranty</span></li>
      <li><span class="tm-hex tm-hex-purple"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h13v11H1zM14 8h4l3 3v4h-7z"/><circle cx="5.5" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/></svg></span><span>Free delivery from 1,100 kr</span></li>
      <li><span class="tm-hex tm-hex-orange"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span><span>Best service in Europe</span></li>
      <li><span class="tm-hex tm-hex-navy"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-6 9 6v11H3z"/><path d="M9 20v-7h6v7"/></svg></span><span>Europe's largest music warehouse</span></li>
    </ul>
  </section>

  <section id="tm-categories" class="tm-section knowledge-base">
    <h2 class="tm-h2">All categories</h2>
    <section class="categories blocks">
      <ul class="blocks-list">
        {{#each categories}}
          {{#if ../has_multiple_categories}}
            <li class="blocks-item">
              <a href='{{url}}' class="blocks-item-link">
                <span class="blocks-item-title">{{name}}</span>
                <span class="blocks-item-description">{{excerpt description}}</span>
              </a>
            </li>
          {{else}}
            {{#each sections}}
              <li class="blocks-item">
                <a href='{{url}}' class="blocks-item-link">
                  <span class="blocks-item-title">{{name}}</span>
                  <span class="blocks-item-description">{{excerpt description}}</span>
                </a>
              </li>
            {{/each}}
          {{/if}}
        {{/each}}
      </ul>
      {{pagination}}
    </section>
  </section>

  <section class="tm-section tm-featured">
    <h2 class="tm-h2"><span class="tm-underline">Popular guides</span></h2>
    <div class="tm-tabs" aria-hidden="true">
      <span class="tm-tab is-active">most read</span>
      <span class="tm-tab">latest</span>
    </div>
    <ul class="tm-card-grid">
      <li class="tm-card">
        <a href="/hc/en-us/p/where-is-my-order" class="tm-card-link">
          <span class="tm-card-media" aria-hidden="true">📦</span>
          <span class="tm-card-tag">Orders</span>
          <span class="tm-card-title">Where is my order?</span>
          <span class="tm-card-text">Check your order status, find the tracking number and see what each status means.</span>
        </a>
      </li>
      <li class="tm-card">
        <a href="/hc/en-us/p/shipping-and-delivery" class="tm-card-link">
          <span class="tm-card-media" aria-hidden="true">🚚</span>
          <span class="tm-card-tag">Delivery</span>
          <span class="tm-card-title">Shipping &amp; delivery</span>
          <span class="tm-card-text">Delivery times, shipping costs and what to do if a parcel arrives damaged.</span>
        </a>
      </li>
      <li class="tm-card">
        <a href="/hc/en-us/p/returns" class="tm-card-link">
          <span class="tm-card-media" aria-hidden="true">↩️</span>
          <span class="tm-card-tag">Returns</span>
          <span class="tm-card-title">How to return an item</span>
          <span class="tm-card-text">Register a return, print the label and get your refund – the 30-day money-back guarantee step by step.</span>
        </a>
      </li>
      <li class="tm-card">
        <a href="/hc/en-us/p/warranty-and-repairs" class="tm-card-link">
          <span class="tm-card-media" aria-hidden="true">🛠️</span>
          <span class="tm-card-tag">Warranty</span>
          <span class="tm-card-title">Warranty &amp; repairs</span>
          <span class="tm-card-text">What the 3-year Thomann warranty covers and how to get something repaired.</span>
        </a>
      </li>
      <li class="tm-card">
        <a href="/hc/en-us/p/payment-and-invoices" class="tm-card-link">
          <span class="tm-card-media" aria-hidden="true">💳</span>
          <span class="tm-card-tag">Payment</span>
          <span class="tm-card-title">Payment methods &amp; invoices</span>
          <span class="tm-card-text">Card, PayPal, Klarna instalments and bank transfer – plus where to find your invoice.</span>
        </a>
      </li>
      <li class="tm-card">
        <a href="/hc/en-us/p/faq" class="tm-card-link">
          <span class="tm-card-media" aria-hidden="true">❓</span>
          <span class="tm-card-tag">FAQ</span>
          <span class="tm-card-title">Frequently asked questions</span>
          <span class="tm-card-text">Quick answers to the questions we hear most about orders, delivery, returns and payment.</span>
        </a>
      </li>
    </ul>
  </section>

  {{#if promoted_articles}}
    <section class="tm-section articles">
      <h2 class="tm-h2"><span class="tm-underline tm-underline-cyan">{{t 'promoted_articles'}}</span></h2>
      <ul class="article-list promoted-articles">
        {{#each promoted_articles}}
          <li class="promoted-articles-item">
            <a href="{{url}}">
              {{title}}
              {{#if internal}}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" focusable="false" viewBox="0 0 16 16" class="icon-lock" title="{{t 'internal'}}">
                  <rect width="12" height="9" x="2" y="7" fill="currentColor" rx="1" ry="1"/>
                  <path fill="none" stroke="currentColor" d="M4.5 7.5V4a3.5 3.5 0 017 0v3.5"/>
                </svg>
              {{/if}}
            </a>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  <section class="tm-section tm-feedback">
    <h2 class="tm-feedback-title">Want to share something with us, or have a question?</h2>
    {{#link 'new_request' class='tm-btn'}}
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11v2a2 2 0 0 0 2 2h2l5 4V5L7 9H5a2 2 0 0 0-2 2z"/><path d="M16 9a4 4 0 0 1 0 6M19 6a8 8 0 0 1 0 12"/></svg>
      Help and feedback
    {{/link}}
  </section>

  {{#if help_center.community_enabled}}
    <section class="section home-section community">
      <h2 class="tm-h2">{{t 'community'}}</h2>
      {{#link 'community' class='tm-btn tm-btn-outline community-link'}}
        {{t 'join_conversation'}}
      {{/link}}
    </section>
  {{/if}}

  <section class="section home-section activity">
    {{#if settings.show_recent_activity}}
      {{recent_activity}}
    {{/if}}
  </section>
</div>
